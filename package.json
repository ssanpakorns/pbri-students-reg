{
  "name": "pbri-students-reg",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:init": "npm run db:init -w server",
    "db:seed": "npm run db:seed -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "build:pages": "npm run build:pages -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
